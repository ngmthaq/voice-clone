MainScreen,
TrainScreen,
SetupScreen {
    align: center top;
}

HomeScreen {
    align: center middle;
}

#home {
    width: 60;
    max-width: 100%;
    height: auto;
    padding: 0 2;
}

#home-title {
    text-style: bold;
    content-align: center middle;
    width: 100%;
    margin-bottom: 2;
}

#home Button {
    width: 100%;
}

.home-hint {
    text-align: center;
    width: 100%;
    margin-bottom: 2;
}

.intro {
    margin-bottom: 1;
    text-style: bold;
}

/* Check setup screen */
#checks {
    height: auto;
    padding: 0 1;
}

/* Group heading sits right above its rows; the first one right below the intro. */
#checks > .section-title {
    margin: 1 0 0 0;
}

#checks > .section-title:first-child {
    margin-top: 0;
}

.check-row {
    height: auto;
    margin-bottom: 1;
}

.check-row.ok .check-line {
    color: $success;
}

.check-row.warning .check-line {
    color: $warning;
}

.check-row.missing .check-line {
    color: $error;
}

.check-fix {
    padding-left: 2;
}

#download-models,
#install-applio,
#measure-speed,
#check-again {
    width: 100%;
    margin-top: 1;
}

#performance-section {
    height: auto;
    margin-top: 1;
}

#performance-section > Rule {
    margin: 0;
}

#performance-section > .section-title {
    margin: 0 0 1 0;
}

#models-progress {
    margin-top: 1;
}

#setup-status {
    height: auto;
    margin: 1 0;
}

#setup-status.error {
    color: $error;
}

#setup-status.warning {
    color: $warning;
}

#setup-status.running {
    color: $success;
}

#applio-log {
    height: 16;
    border: round $panel;
}

/* The scroll area fills the terminal, so the mouse wheel and trackpad scroll from
   anywhere. The content stays in a centred column. */
#panel {
    width: 100%;
    height: 1fr;
    padding: 1 2 0 2;
    align-horizontal: center;
    /* No scrollbar: the page still scrolls with the mouse wheel, trackpad or Tab key. */
    scrollbar-size-vertical: 0;
}

#panel > .page {
    width: 74;
    max-width: 100%;
    height: auto;
}

/* Tabs are as tall as their content, so Start sits right below it.
   When it does not fit, the whole page scrolls. */
#tabs,
#tabs ContentSwitcher,
#tabs TabPane {
    height: auto;
}

/* One empty line between the tab bar and the first setting; no side padding, so every
   setting lines up with the tab bar and the Start button. */
#tabs TabPane {
    padding: 1 0 0 0;
}

#controls {
    height: auto;
    padding-bottom: 1;
}

/* Every setting: label, control, an optional hint, then two empty lines. */
.field {
    height: auto;
    margin-bottom: 2;
}

.field-label {
    color: $text-muted;
}

.field Input,
.field Select {
    width: 100%;
}

/* No side borders, so a box is exactly as wide as the buttons. Padding keeps the text
   where the border used to push it. */
.field Input,
.field SelectCurrent {
    border-left: none;
    border-right: none;
    padding: 0 3;
}

.hint {
    color: $text-muted;
    text-style: italic;
}

.section-title {
    text-style: bold;
    margin: 1 0;
}

#pitch-row {
    height: 3;
}

#pitch-row Button {
    min-width: 5;
}

#pitch-label {
    width: 9;
    height: 3;
    content-align: center middle;
}

#advanced-reset {
    width: 100%;
}

/* Same side margin as the voice changer's tab content. */
TrainPanelWidget,
.intro {
    height: auto;
    padding: 0 1;
}

/* An empty line after the last message, above the footer (like the voice changer). */
TrainPanelWidget {
    padding-bottom: 1;
}

TrainPanelWidget Checkbox {
    width: 100%;
}

#train-button {
    margin-top: 1;
    width: 100%;
}

#train-progress,
#train-status {
    margin-top: 1;
}

#train-status {
    height: auto;
}

#train-log {
    height: 16;
    margin-top: 1;
    border: round $panel;
}

#start-button {
    margin-top: 1;
    width: 100%;
}

LevelMeterWidget {
    height: 1;
    margin-top: 1;
}

#download-progress {
    margin-top: 1;
}

#status {
    margin-top: 1;
    height: auto;
}

#status.error,
#train-status.error {
    color: $error;
}

#status.warning,
#train-status.warning {
    color: $warning;
}

#status.running,
#train-status.running {
    color: $success;
}


/* Disabled controls must look inactive: no hover highlight, no clickable pointer. */
Button.-style-default:disabled:hover {
    background: $surface;
    border-top: tall $surface-lighten-1;
}

Button.-style-default.-primary:disabled:hover {
    background: $primary;
    border-top: tall $primary-lighten-3;
}

Button.-style-default.-success:disabled:hover {
    background: $success;
    border-top: tall $success-lighten-2;
}

Button.-style-default.-warning:disabled:hover {
    background: $warning;
    border-top: tall $warning-lighten-2;
}

Button.-style-default.-error:disabled:hover {
    background: $error;
    border-top: tall $error-lighten-2;
}

Select:disabled > SelectCurrent,
Input:disabled {
    pointer: not-allowed;
}
