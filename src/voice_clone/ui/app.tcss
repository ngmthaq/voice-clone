MainScreen {
    align: center top;
}

#panel {
    width: 74;
    max-width: 100%;
    height: 1fr;
    padding: 1 2 0 2;
    /* No scrollbar: the page still scrolls with the mouse wheel, trackpad or Tab key. */
    scrollbar-size-vertical: 0;
}

/* Tabs are as tall as their content, so Start sits right below it.
   When it does not fit, the whole page scrolls. */
#tabs,
#tabs ContentSwitcher,
#tabs TabPane {
    height: auto;
}

#tabs TabPane {
    padding: 0 1;
}

#controls {
    height: auto;
    padding-bottom: 1;
}

/* Every setting: label, control, an optional hint, then two empty lines. */
.field {
    height: auto;
    margin-bottom: 2;
}

.field-label {
    color: $text-muted;
}

.field Input,
.field Select {
    width: 100%;
}

.hint {
    color: $text-muted;
    text-style: italic;
}

.section-title {
    text-style: bold;
    margin: 1 0;
}

#pitch-row {
    height: 3;
}

#pitch-row Button {
    min-width: 5;
}

/* An Input's left border has the background colour, so its box starts one cell in.
   Indent the pitch buttons the same so they line up with the inputs. */
#pitch-down {
    margin-left: 1;
}

#pitch-label {
    width: 9;
    height: 3;
    content-align: center middle;
}

#voice-reset,
#gate-reset {
    width: 100%;
}

#start-button {
    margin-top: 1;
    width: 100%;
}

LevelMeterWidget {
    height: 1;
    margin-top: 1;
}

#download-progress {
    margin-top: 1;
}

#status {
    margin-top: 1;
    height: auto;
}

#status.error {
    color: $error;
}

#status.warning {
    color: $warning;
}

#status.running {
    color: $success;
}


/* Disabled controls must look inactive: no hover highlight, no clickable pointer. */
Button.-style-default:disabled:hover {
    background: $surface;
    border-top: tall $surface-lighten-1;
}

Button.-style-default.-primary:disabled:hover {
    background: $primary;
    border-top: tall $primary-lighten-3;
}

Button.-style-default.-success:disabled:hover {
    background: $success;
    border-top: tall $success-lighten-2;
}

Button.-style-default.-warning:disabled:hover {
    background: $warning;
    border-top: tall $warning-lighten-2;
}

Button.-style-default.-error:disabled:hover {
    background: $error;
    border-top: tall $error-lighten-2;
}

Select:disabled > SelectCurrent,
Input:disabled {
    pointer: not-allowed;
}
