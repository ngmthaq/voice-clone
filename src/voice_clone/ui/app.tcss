MainScreen {
    align: center top;
}

#panel {
    width: 70;
    max-width: 100%;
    height: auto;
    padding: 1 2;
}

.field-label {
    margin-top: 1;
    color: $text-muted;
}

#pitch-row {
    height: 3;
    margin-top: 1;
}

#pitch-row Button {
    min-width: 5;
}

#pitch-label {
    width: 18;
    height: 3;
    content-align: center middle;
}

#start-button {
    margin-top: 1;
    width: 100%;
}

LevelMeterWidget {
    height: 1;
    margin-top: 1;
}

#download-progress {
    margin-top: 1;
}

#status {
    margin-top: 1;
    height: auto;
}

#status.error {
    color: $error;
}

#status.warning {
    color: $warning;
}

#status.running {
    color: $success;
}
